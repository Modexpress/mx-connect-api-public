{
  "type": "object",
  "required": [
    "Articles"
  ],
  "properties": {
    "Articles": {
      "type": "object",
      "required": [
        "Article"
      ],
      "properties": {
        "Article": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Fabric",
              "HSCode",
              "UnitOfMeasure",
              "Weight",
              "CountryOfOrigin"
            ],
            "properties": {
              "Id": {
                "description": "The identification that the supplier uses for the Material. This is usually a logical Id.\nIf the identification contains letters, they must be in uppercase.\nLeading and trailing spaces are not allowed.\n",
                "type": "string",
                "minLength": 1,
                "maxLength": 35
              },
              "Description": {
                "description": "The description of the SKU.\n",
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "Fabric": {
                "description": "The composition of the material, defined by percentage per composite (f.e. '100% Brass' or '98% cotton, 2% elastane').\n",
                "type": "string",
                "minLength": 1
              },
              "HSCode": {
                "description": "The description of the SKU.\n",
                "type": "string",
                "minLength": 10,
                "maxLength": 10
              },
              "UnitOfMeasure": {
                "description": "Indication of the way the default Unit of Measure, typical for the material PCE: pieces, MTR:meter, SQM: squaremeter\n",
                "type": "string",
                "minLength": 1,
                "maxLength": 3,
                "enum": [
                  "PCE",
                  "MTR",
                  "SQM"
                ]
              },
              "Width": {
                "description": "The width of the Material expressed in millimetres.\nrequired to convert MTR into SQM if required\n",
                "type": "number"
              },
              "Weight": {
                "description": "The weight of the Material per Unit of Measure.\n",
                "type": "number"
              },
              "CountryOfOrigin": {
                "description": "The country of origin of the Material. Use ISO-2 country code.\n",
                "type": "string",
                "minLength": 2,
                "maxLength": 2
              }
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-04/schema#"
}